{
  "name": "tailspin-toys",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node ./run-node-tool.mjs ./node_modules/astro/bin/astro.mjs dev",
    "build": "node ./run-node-tool.mjs ./node_modules/astro/bin/astro.mjs build",
    "preview": "node ./run-node-tool.mjs ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node ./run-node-tool.mjs ./node_modules/astro/bin/astro.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ./run-node-tool.mjs ./node_modules/tsx/dist/cli.mjs db/migrate.ts",
    "db:seed": "node ./run-node-tool.mjs ./node_modules/tsx/dist/cli.mjs db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "predev": "npm run db:setup",
    "prebuild": "npm run db:setup",
    "test:unit": "node ./run-node-tool.mjs ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node ./run-node-tool.mjs ./node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "node ./run-node-tool.mjs ./node_modules/@playwright/test/cli.js install chromium",
    "typecheck": "node ./run-node-tool.mjs ./node_modules/@typescript/native-preview/bin/tsgo --noEmit -p tsconfig.tsgo.json",
    "typecheck:astro": "node ./run-node-tool.mjs ./node_modules/astro/bin/astro.mjs sync && node ./run-node-tool.mjs ./node_modules/astro/bin/astro.mjs check",
    "typecheck:all": "npm run typecheck && npm run typecheck:astro",
    "lint": "node ./run-node-tool.mjs ./node_modules/eslint/bin/eslint.js ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "drizzle-orm": "^0.45.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.0",
    "globals": "^17.8.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
